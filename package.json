{
  "name": "tooling-suite",
  "version": "0.0.3",
  "description": "Suite of code-quality tools (biome, exportcase, tsc, vitest, stryker, ignore-comment check) bundled behind a single CLI",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts",
    "src",
    "biome.json",
    "stryker.config.json"
  ],
  "scripts": {
    "test": "tooling-suite biome exportcase typecheck no-ignore-comments"
  },
  "exports": {
    "types": "./index.d.ts",
    "default": "./index.mjs"
  },
  "bin": {
    "tooling-suite": "./src/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "typescript": "x"
  },
  "license": "MIT",
  "dependencies": {
    "@biomejs/biome": "^2.6.4",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "exportcase": "^1.4.0",
    "vitest": "^5.1.0"
  }
}
